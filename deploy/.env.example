# Production settings for deploy/docker-compose.yml.
# On the server: cp .env.example .env, fill in, `chmod 600 .env`.
# Never commit the real .env.

# --- Site ---
# Domain whose DNS A record points to this server.
DOMAIN=calendar.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=you@example.com

# --- Image ---
APP_IMAGE=ghcr.io/andreyzubov/family-calendar
# Release tag to run, e.g. 1.0.0 (avoid "latest": deploys must be reproducible).
APP_VERSION=

# --- Database ---
# Letters and digits only (it is embedded in a URL): openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Google sign-in ---
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID,
# type "Web application", authorized redirect URI: https://<DOMAIN>/auth/callback
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Sessions ---
# openssl rand -base64 32
SESSION_SECRET=
SESSION_TTL=720h

# --- Optional ---
LOG_LEVEL=info
# Host ports (change only for testing on a machine where 80/443 are taken).
HTTP_PORT=80
HTTPS_PORT=443
