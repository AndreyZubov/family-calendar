# Local development configuration.
# Copy to .env (never committed) and fill in the empty values:
#   cp .env.example .env
# The Makefile exports these variables to the backend and docker compose.
# Keep values unquoted and without inline comments.

# --- Application ---
# development | production
APP_ENV=development
# Address the Go server listens on
HTTP_ADDR=:8080
# Public URL the browser uses. In dev this is the Vite server, which proxies
# /api and /auth to the backend, so cookies stay on one origin.
APP_BASE_URL=http://localhost:5173
# debug | info | warn | error
LOG_LEVEL=debug

# --- Database (local Postgres from deploy/docker-compose.dev.yml) ---
POSTGRES_USER=calendar
POSTGRES_PASSWORD=calendar
POSTGRES_DB=calendar
POSTGRES_PORT=5433
DATABASE_URL=postgres://calendar:calendar@localhost:5433/calendar?sslmode=disable

# --- Authentication (OpenID Connect) ---
OIDC_ISSUER_URL=https://accounts.google.com
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (type "Web application", redirect URI: http://localhost:5173/auth/callback)
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Key for signing short-lived auth cookies (state/nonce/PKCE verifier).
# Generate with: openssl rand -base64 32
SESSION_SECRET=
