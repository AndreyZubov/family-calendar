# Send the Docker daemon only what the build needs: faster builds, and no
# secrets or local junk can end up in an image layer.
*
!backend/
!frontend/

# Within the allowed directories, still exclude:
backend/bin/
backend/coverage.*
backend/internal/web/dist/*
!backend/internal/web/dist/.gitkeep
frontend/node_modules/
frontend/dist/
frontend/coverage/
frontend/test-results/
frontend/playwright-report/
**/.env
**/.env.*
**/*.pem
**/*.key
**/.DS_Store
